# ---------------------------------------------------------------------------
# Model weights and generated media must NEVER be committed. This repo is the
# *recipe* (scripts + workflows), not the artifacts — download_models.sh
# rebuilds ~64 GB of weights from scratch.
# ---------------------------------------------------------------------------
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
*.gguf
*.onnx

models/
outputs/
output/
input/
__pycache__/
*.pyc

# generated media
*.mp4
*.webm
*.webp
*.png
*.jpg
*.jpeg
*.gif
*.wav

# The ComfyUI checkout is upstream code with its own .git and multi-GB models.
# It is NOT part of this recipe — install it separately (see README).
ComfyUI/

# Vast.ai instance scaffolding (symlinks into /etc)
AGENTS.md
CLAUDE.md
.hf_home/
.venv-backups/
.sync_*.lock
.env
