{
  "1": {
    "class_type": "UNETLoader",
    "_meta": { "title": "Load Diffusion Model (FLUX.1-dev fp8)" },
    "inputs": {
      "unet_name": "flux1-dev-fp8-e4m3fn.safetensors",
      "weight_dtype": "fp8_e4m3fn"
    }
  },
  "2": {
    "class_type": "DualCLIPLoader",
    "_meta": { "title": "DualCLIPLoader (CLIP-L + T5-XXL)" },
    "inputs": {
      "clip_name1": "clip_l.safetensors",
      "clip_name2": "t5xxl_fp8_e4m3fn_scaled.safetensors",
      "type": "flux",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": { "title": "Load VAE (FLUX ae)" },
    "inputs": {
      "vae_name": "ae.safetensors"
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "CLIP Text Encode (Positive Prompt)" },
    "inputs": {
      "text": "A photorealistic close-up of a red fox standing in a misty pine forest at sunrise, golden rim light through the fog, shallow depth of field, highly detailed fur, 85mm lens",
      "clip": ["2", 0]
    }
  },
  "5": {
    "class_type": "FluxGuidance",
    "_meta": { "title": "FluxGuidance" },
    "inputs": {
      "conditioning": ["4", 0],
      "guidance": 3.5
    }
  },
  "6": {
    "class_type": "ConditioningZeroOut",
    "_meta": { "title": "ConditioningZeroOut (negative placeholder)" },
    "inputs": {
      "conditioning": ["4", 0]
    }
  },
  "7": {
    "class_type": "EmptySD3LatentImage",
    "_meta": { "title": "EmptySD3LatentImage (16-channel)" },
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    }
  },
  "8": {
    "class_type": "KSampler",
    "_meta": { "title": "KSampler" },
    "inputs": {
      "model": ["1", 0],
      "seed": 219873456,
      "steps": 20,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["5", 0],
      "negative": ["6", 0],
      "latent_image": ["7", 0],
      "denoise": 1.0
    }
  },
  "9": {
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE Decode" },
    "inputs": {
      "samples": ["8", 0],
      "vae": ["3", 0]
    }
  },
  "10": {
    "class_type": "SaveImage",
    "_meta": { "title": "Save Image" },
    "inputs": {
      "images": ["9", 0],
      "filename_prefix": "flux_t2i"
    }
  }
}
