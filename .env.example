# Copy to /workspace/.env and fill in. Never commit the real .env.
#   chmod 600 /workspace/.env

# ElevenLabs (Stage 3 voiceover). The key is IP-restricted - allowlist the
# box's egress IP in the ElevenLabs dashboard or TTS returns ip_not_allowed.
ELEVEN_API_KEY=
ELEVEN_KEY_NAME=

# MinIO / S3 behind the bucket-scoped nginx rewrite.
# NOTE: this endpoint rewrites /<key> -> /<bucket>/<key>, so a standard S3
# client fails with SignatureDoesNotMatch. minio_upload.py signs the
# POST-rewrite path, which is why it works where the SDK and mc do not.
MINIO_ENDPOINT=staging-storage.runkarobar.com
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=runkarobar
